# ---- .NET 构建产物 ----
bin/
obj/
*.user
*.suo
.vs/

# ---- 本项目特有：构建出来的可执行文件不入库 ----
# publish/ 是用 build.ps1 生成的产物（单文件 exe + 配置），源码才是唯一真源。
# 想留发布包就把它注释掉。
apps/MemoryDeck/publish/

# ---- 打包产物 ----
# dist/ 是 package.ps1 生成的发布包，随时可以用脚本重出，不入库。
dist/

# ---- 运行期数据 / 自动备份 ----
# .memory-deck/backups 是程序每次写入前自动复制的备份，属于运行期数据。
.memory-deck/

# ---- 临时与日志 ----
*.log
*.tmp
*.bak
*.tmp-*

# ---- 编辑器 / 系统 ----
.idea/
*.swp
Thumbs.db
desktop.ini

# ---- 本地工具生成物（不属于产品） ----
docs/agents/

# ---- 安装工程的构建产物 ----
# payload\ 里的 exe / launcher / runtime 都是构建时生成或下载的，
# 用 installer\build.py 可以重现（runtime 从微软官方下载并做 SHA-512 校验）。
installer/payload/runtime/
installer/payload/MemoryDeck.exe
installer/payload/MemoryDeckLauncher.exe
installer/download-cache/
installer/dist/