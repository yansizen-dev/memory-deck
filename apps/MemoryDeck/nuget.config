<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    本机 NuGet 全局配置里有一条来自 Visual Studio 的 fallbackPackageFolders，
    指向已被删除的 F:\C++\工具\NuGetPackages，会让 restore/build 直接抛
    PackagingException。项目级清空它即可，不去改用户全局配置。

    packageSources 保持默认（nuget.org），因为 RID 专用发布需要下载运行时包。
  -->
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
</configuration>
